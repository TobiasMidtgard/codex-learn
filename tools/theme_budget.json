    { "name": ".gmark.fail — the failed fill", "kind": "graphic", "fg": "var(--bad)", "bg": ["var(--surface)", "var(--ground)"] },

    { "name": "STATE .inav — hover against idle", "kind": "state", "from": ".inav:hover", "vs": ["var(--nav)", "var(--ground)"] },
    { "name": "STATE .inav — current against idle", "kind": "state", "vs": ["var(--nav)", "var(--ground)"], "bg": ["var(--lime-22)", "var(--nav)", "var(--ground)"] },
    { "name": "STATE .tbtn — hover against idle", "kind": "state", "from": ".tbtn:hover", "vs": ["var(--head)", "var(--ground)"] },
    { "name": "STATE a rail row — hover against idle", "kind": "state", "from": ".rail-course:hover", "vs": ["rgba(11,12,15,0.45)", "var(--ground)"], "vsLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": "STATE a rail row — current against idle", "kind": "state", "vs": ["rgba(11,12,15,0.45)", "var(--ground)"], "vsLight": ["rgba(255,255,255,0.5)", "var(--ground)"], "bg": ["var(--lime-22)", "rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["var(--lime-22)", "rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": "STATE a band button — hover against idle", "kind": "state", "from": ".rail-track>button:hover", "vs": ["rgba(11,12,15,0.45)", "var(--ground)"], "vsLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },

    { "name": ".btn.accent — its label", "kind": "text", "fg": "var(--accent-ink)", "bg": ["var(--lime-12)", "var(--surface)", "var(--ground)"] },
    { "name": ".btn.dark — its label", "kind": "text", "fg": "var(--ink-2)", "bg": ["rgba(255,255,255,0.05)", "var(--surface)", "var(--ground)"], "bgLight": ["rgba(15,25,5,0.05)", "var(--surface)", "var(--ground)"] },
    { "name": "STATE .btn.dark — its fill against the card", "kind": "state", "from": ".btn.dark", "vs": ["var(--surface)", "var(--ground)"] },
    { "name": "STATE .btn.dark — hover against its own fill", "kind": "state", "from": ".btn.dark:hover", "vs": ["rgba(255,255,255,0.05)", "var(--surface)", "var(--ground)"], "vsLight": ["rgba(15,25,5,0.05)", "var(--surface)", "var(--ground)"] },
    { "name": "STATE .btn.ghost — hover against the card", "kind": "state", "from": ".btn.ghost:hover", "vs": ["var(--surface)", "var(--ground)"] },
