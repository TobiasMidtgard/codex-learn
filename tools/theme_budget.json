{
  "_": [
    "What every surface in the application shell measures, in both themes, recomputed",
    "from src/index.head.html's own token tables by tools/verify_theme.mjs.",
    "",
    "kind: text    -> 4.5:1  (WCAG 1.4.3; everything here is under 18.66px)",
    "      large   -> 3.0:1  (>=24px, or >=18.66px bold)",
    "      graphic -> 3.0:1  (WCAG 1.4.11: an icon, a fill or a state marker)",
    "      state   -> 1.1:1  between two BACKGROUNDS, which is the only way to ask",
    "                        whether a hover or a current-item tint is visible at all.",
    "                        Not a WCAG number: 1.00 is what .inav:hover measured in",
    "                        the light theme, and 1.1 is the floor that catches it.",
    "",
    "A background stack is written outermost-last and composites down onto --ground.",
    "bgLight overrides bg when the light theme re-declares that surface (.rail does).",
    "",
    "A state entry with \"from\" does not restate the hover colour: the gate reads it out",
    "of that rule, and out of its [data-theme=light] twin, falling back to the dark value",
    "when the twin is missing. That fallback IS the .inav:hover defect, so it is measured",
    "rather than described."
  ],
  "surfaces": [
    { "name": ".logo span — the brand glyph", "kind": "text", "fg": "var(--on-lime)", "bg": ["var(--lime)", "var(--nav)", "var(--ground)"] },
    { "name": ".inav — an idle section icon", "kind": "graphic", "fg": "var(--ink-4)", "bg": ["var(--nav)", "var(--ground)"] },
    { "name": ".inav.active — the current section icon", "kind": "graphic", "fg": "var(--accent-ink)", "bg": ["var(--lime-22)", "var(--nav)", "var(--ground)"] },
    { "name": ".inav.active::before — the current-section bar", "kind": "graphic", "fg": "var(--lime)", "bg": ["var(--nav)", "var(--ground)"] },
    { "name": ".avatar — level or initials, blue end", "kind": "text", "fg": "var(--on-avatar)", "bg": ["var(--blue)"] },
    { "name": ".avatar — level or initials, purple end", "kind": "text", "fg": "var(--on-avatar)", "bg": ["var(--purple)"] },
    { "name": ".prof-av — the same disc at 24px bold", "kind": "large", "fg": "var(--on-avatar)", "bg": ["var(--purple)"] },
    { "name": ".skip — the skip link", "kind": "text", "fg": "var(--on-lime)", "bg": ["var(--lime)"] },

    { "name": ".screen-id b — the screen title", "kind": "text", "fg": "var(--ink)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".screen-id span — the screen crumb", "kind": "text", "fg": "var(--ink-4)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".search input::placeholder", "kind": "text", "fg": "var(--ink-4)", "bg": ["rgba(255,255,255,0.03)", "var(--head)", "var(--ground)"], "bgLight": ["rgba(15,25,5,0.03)", "var(--head)", "var(--ground)"] },
    { "name": ".search .kbd — the shortcut hint", "kind": "text", "fg": "var(--ink-4)", "bg": ["rgba(255,255,255,0.03)", "var(--head)", "var(--ground)"], "bgLight": ["rgba(15,25,5,0.03)", "var(--head)", "var(--ground)"] },
    { "name": ".metric.streak b — the streak figure", "kind": "text", "fg": "var(--amber)", "bg": ["var(--amber-08)", "var(--head)", "var(--ground)"] },
    { "name": ".metric.xp b — the XP figure", "kind": "text", "fg": "var(--accent-ink)", "bg": ["var(--lime-08)", "var(--head)", "var(--ground)"] },
    { "name": ".metric span — the pill labels", "kind": "text", "fg": "var(--ink-3)", "bg": ["var(--lime-08)", "var(--head)", "var(--ground)"] },
    { "name": ".tbtn — notepad and theme", "kind": "graphic", "fg": "var(--ink-3)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".menu-btn — the drawer button", "kind": "graphic", "fg": "var(--ink-3)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".rail-btn — the panel toggle, idle", "kind": "graphic", "fg": "var(--ink-4)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".rail-btn.on — the panel toggle, lit", "kind": "graphic", "fg": "var(--accent-ink)", "bg": ["var(--lime-22)", "var(--head)", "var(--ground)"] },
    { "name": ".save-state — idle", "kind": "text", "fg": "var(--ink-4)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": ".save-state.bad — progress is not being stored", "kind": "text", "fg": "var(--amber)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": "the focus ring on the topbar", "kind": "graphic", "fg": "var(--lime)", "bg": ["var(--head)", "var(--ground)"] },
    { "name": "the focus ring on the icon rail", "kind": "graphic", "fg": "var(--lime)", "bg": ["var(--nav)", "var(--ground)"] },

    { "name": ".rail-sec — a programme heading", "kind": "text", "fg": "var(--accent-ink)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-track .t-name — a band label", "kind": "text", "fg": "var(--ink)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-track .t-pct — a band count", "kind": "text", "fg": "var(--ink-4)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-module h4 — a module heading", "kind": "text", "fg": "var(--ink-4)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-course / .rail-lesson — an idle row", "kind": "text", "fg": "var(--ink-3)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".cid / .num / .lk — the mono counters", "kind": "text", "fg": "var(--ink-4)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-*.active — the current row's title", "kind": "text", "fg": "var(--ink)", "bg": ["var(--lime-22)", "rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["var(--lime-22)", "rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-*.active — its 2px left bar", "kind": "graphic", "fg": "var(--lime)", "bg": ["var(--lime-22)", "rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["var(--lime-22)", "rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".rail-miss — a programme failed to load", "kind": "text", "fg": "var(--ink-3)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".gmark — the idle ring, on the rail", "kind": "graphic", "fg": "var(--mark-idle)", "bg": ["rgba(11,12,15,0.45)", "var(--ground)"], "bgLight": ["rgba(255,255,255,0.5)", "var(--ground)"] },
    { "name": ".gmark — the idle ring, on a card", "kind": "graphic", "fg": "var(--mark-idle)", "bg": ["var(--surface)", "var(--ground)"] },
