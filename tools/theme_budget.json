    {"name":".dsk-tips — what the calculator understands","kind":"text","fg":"var(--ink-3)","bg":["var(--sunk)","var(--surface-solid)"],"sel":".dsk-tips"},
    {"name":".dsk-tips b — its headings","kind":"text","fg":"var(--ink-2)","bg":["var(--sunk)","var(--surface-solid)"],"sel":".dsk-tips b"},
    {"name":".dsk-tips code — the examples in it","kind":"text","fg":"var(--lime)","bg":["var(--sunk)","var(--surface-solid)"],"sel":".dsk-tips code"},
    {"name":".dsk-pick — a pad you are not on","kind":"text","fg":"var(--ink-4)","bg":["var(--surface-solid)"],"sel":".dsk-pick"},
    {"name":".dsk-pick[aria-pressed=true] — the pad you are on","kind":"text","fg":"var(--lime)","bg":["var(--lime-08)","var(--surface-solid)"],"sel":".dsk-pick[aria-pressed=true]"},
    {"name":".dsk-saved — when the note was last saved","kind":"text","fg":"var(--ink-3)","bg":["var(--surface-solid)"],"sel":".dsk-saved"},
    {"name":".dsk-saved.warn — COULD NOT SAVE, the one message that must be read","kind":"text","fg":"var(--amber)","bg":["var(--surface-solid)"],"sel":".dsk-saved.warn"},
    {"name":".dsk-ta — the note itself","kind":"text","fg":"var(--on-editor)","bg":["var(--editor)"],"sel":".dsk-ta"},
    {"name":".dsk-ta::placeholder — quieter than the note, on purpose","kind":"text","fg":"var(--on-editor-3)","bg":["var(--editor)"],"sel":".dsk-ta::placeholder","floor":2.5},
    {"name":".dsk-notefoot — the character and line count","kind":"text","fg":"var(--ink-3)","bg":["var(--sunk)","var(--surface-solid)"],"sel":".dsk-notefoot"}
  ]
}
