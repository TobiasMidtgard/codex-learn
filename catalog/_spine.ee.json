{
  "program": {
    "id": "ee-msc",
    "name": "Electrical Engineering — 5 Year Program",
    "short": "Electrical Engineering",
    "emphasis": "Electrical Engineering",
    "subtitle": "Integrated BSc + MSc track, 30 courses, from Ohm’s law to a silicon pipeline. Every topic opens in something you can push on, derives the mathematics with you, and ends at a bench.",
    "bandNoun": "Year",
    "accent": "#6E9BFF",
    "bands": [
      {
        "n": 1,
        "title": "Circuits, Fields & Foundations",
        "theme": "What a current is, what a field is, and the mathematics needed to say anything precise about either.",
        "icon": "◴",
        "tint": "#E4EEFA"
      },
      {
        "n": 2,
        "title": "Devices, Signals & Instruments",
        "theme": "Semiconductors that switch and amplify, signals described as spectra, and the discipline of actually measuring something.",
        "icon": "◵",
        "tint": "#FFE9DC"
      },
      {
        "n": 3,
        "title": "Systems & Analysis",
        "theme": "State space, sampling, transmission lines, converters and pipelines — the working language of every specialisation above.",
        "icon": "◶",
        "tint": "#E1F4E8"
      },
      {
        "n": 4,
        "title": "Advanced Practice",
        "theme": "Optimal control, adaptive filtering, noise, matching networks, drives and memory hierarchies.",
        "icon": "◷",
        "tint": "#F1E8FB"
      },
      {
        "n": 5,
        "title": "Specialisation & Capstone",
        "theme": "Non-linear control, fixed-point DSP, synthesis, photonics, magnetics and verification, each ending in something built.",
        "icon": "⬤",
        "tint": "#FFF3D6"
      }
    ]
  },
