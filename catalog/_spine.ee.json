  "program": {
    "id": "ee-msc",
    "name": "Electrical Engineering — M.S.",
    "emphasis": "Electrical Engineering",
    "subtitle": "Six graduate tracks. Every topic opens in a sandbox you can push on, derives the mathematics with you rather than at you, and ends at a bench.",
    "bandNoun": "Track",
    "accent": "#6E9BFF",
    "bands": [
      {
        "n": 1,
        "title": "Advanced Analog & RF IC Design",
        "theme": "What a transistor actually does at a gigahertz, and why noise sets the floor on everything you can measure.",
        "icon": "◈",
        "tint": "#E4EEFA"
      },
      {
        "n": 2,
        "title": "Modern & Non-Linear Control",
        "theme": "State-space as the working language: place poles, prove stability, estimate what you cannot measure.",
        "icon": "◉",
        "tint": "#E1F4E8"
      },
      {
        "n": 3,
        "title": "Digital Signal Processing & Machine Learning",
        "theme": "Rate changes, adaptive filters, and the arithmetic that survives contact with a fixed-point DSP.",
        "icon": "◊",
        "tint": "#F1E8FB"
      },
      {
        "n": 4,
        "title": "Power Electronics & Drives",
        "theme": "Switching hard enough to be efficient and softly enough to survive, then turning it into torque.",
        "icon": "◐",
        "tint": "#FFE9DC"
      },
      {
        "n": 5,
        "title": "Advanced Electromagnetics & Photonics",
        "theme": "Fields obeying boundary conditions: guided waves, matched loads, and light in a dielectric.",
        "icon": "◎",
        "tint": "#FFF3D6"
      },
      {
        "n": 6,
        "title": "VLSI & Embedded Architecture",
        "theme": "A pipeline you can single-step, a memory hierarchy you can starve, and RTL you can drive with a testbench.",
        "icon": "▣",
        "tint": "#E8EEF4"
      }
    ],
